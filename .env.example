# ---------------------------------------------------------------------------
# SoulCMS environment
# ---------------------------------------------------------------------------

APP_NAME=SoulCMS
APP_ENV=production
APP_DEBUG=false
APP_URL_SCHEME=http
APP_URL_HOST=localhost
APP_URL_PATH=
APP_TIMEZONE=UTC
APP_LOCALE=vi

# ---------------------------------------------------------------------------
# Database: sqlite | mysql | mariadb | pgsql
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=
DB_HOST=127.0.0.1
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_general_ci

# PostgreSQL only
DB_SSLMODE=

# SQLite only
DB_SQLITE_JOURNAL_MODE=WAL
DB_SQLITE_SYNCHRONOUS=NORMAL

# ---------------------------------------------------------------------------
# Session & security
# ---------------------------------------------------------------------------
SESSION_NAME=SoulCMS
SESSION_LIFETIME=86400
SESSION_SAME_SITE=Lax
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=30
RATE_LIMIT_DECAY_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=300

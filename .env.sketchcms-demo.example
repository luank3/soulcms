# Local-only credentials for the SketchCMS compatibility demo.
# Generate new values before starting the containers.
SKETCHCMS_DB_ROOT_PASSWORD=replace-with-a-random-root-password
SKETCHCMS_DB_PASSWORD=replace-with-a-random-app-password
SKETCHCMS_ADMIN_PASSWORD=secret123
SOULCMS_APP_KEY=replace-with-at-least-32-random-characters
SKETCHCMS_HTTP_PORT=8081
SOULCMS_HTTP_PORT=8000
